{
    "description": "This interface can be used to set the maximum allowed SoC. If activateMaxSoc is true, the integration plugin shall limit the SoC to setMaxSoC. If activateMaxSoC changes from true to false, the integration plugin shall restore the previously used SoC limit.",
    "extends": [],
    "states": [
        {
            "name": "activateMaxSoC",
            "displayName": "Activate maximum SoC",
            "displayNameEvent": "Activate maximum SoC changed",
            "type": "bool",
            "defaultValue": false,
            "cached": true,
            "writable": true
        },
        {
            "name": "setMaxSoC",
            "displayName": "Maximum SoC setting",
            "displayNameEvent": "Maximum SoC setting changed",
            "type": "uint",
            "unit": "Percentage",
            "defaultValue": 100,
            "writable": true,
            "cached": true
        }
    ]
}
