{
    "deprecated": "For limiting battery charging power or current use limitableconsumer instead",
    "description": "This interface can be used for limitable batteries offering an api to set the maximum allowed SoC or maximum allowed charging current.",
    "extends": ["energystorage"],
    "states": [        
        {
            "name": "maxChargingCurrent",
            "type": "double",
            "writable": true,
            "unit": "Ampere",
            "minValue": 0,
            "maxValue": "any"
        },
        {
            "name": "enableMaxChargingCurrent",
            "type": "bool",
            "defaultValue": false,
            "writable": true
        },
        {
            "name": "setMaxSoC",
            "type": "uint",
            "unit": "Percentage",
            "defaultValue": 100,
            "writable": true,
            "cached": true,
            "optional": true
        }
    ]
}
