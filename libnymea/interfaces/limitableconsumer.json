            "type": "bool",
            "defaultValue": false,
            "cached": true,
            "writable": true
        },
        {
            "name": "powerLimitConsumer",
            "displayName": "Power limit consumer",
            "displayNameAction": "Set power limit consumer",
            "type": "double",
            "unit": "Watt",
            "defaultValue": 0,
            "minValue": 0,
            "maxValue": "any",
            "cached": true,
            "writable": true
        },
        {
            "name": "controllableLocalSystem",
            "displayName": "Controllable local system (CLS)",
            "displayNameAction": "Set controllable local system (CLS)",
            "type": "bool",
            "defaultValue": false,
            "cached": true,
            "writable": true
        }
    ]
}